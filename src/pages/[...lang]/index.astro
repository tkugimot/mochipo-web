---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOKIMOCHI_APP_STORE_URL } from '../../consts';
import { langFromPath, langStaticPaths, localePath } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

// Placeholder copy: replace with the real LP text.
const copy = {
  ja: {
    name: '時もち',
    title: '時もち',
    description: '時もちは、スマホとの付き合い方を見直すためのアプリです。',
    tagline: 'Be Time Rich',
    lead: '【ここにアプリの説明文】',
    problemTitle: '課題',
    problem: '【ここに課題の説明】',
    solutionTitle: '時もちができること',
    solution: ['【特徴1】', '【特徴2】', '【特徴3】'],
    cta: 'App Storeでダウンロード',
    more: '私たちが実現したいこと',
  },
  en: {
    name: 'Time Rich',
    title: 'Time Rich',
    description: 'Time Rich helps you rethink your relationship with your smartphone.',
    tagline: 'Time is Money. Be Time Rich.',
    lead: '[App description goes here]',
    problemTitle: 'The problem',
    problem: '[Problem statement goes here]',
    solutionTitle: 'What Time Rich does',
    solution: ['[Feature 1]', '[Feature 2]', '[Feature 3]'],
    cta: 'Download on the App Store',
    more: 'What we want to achieve',
  },
};
const lang = langFromPath(Astro.url.pathname);
const c = copy[lang];
---

<BaseLayout title={c.title} description={c.description} wide>
  <section class="py-8 text-center sm:py-16">
    <h1 class="text-4xl font-bold sm:text-5xl">{c.name}</h1>
    <p class="mt-4 text-xl text-slate-600">{c.tagline}</p>
    <p class="mx-auto mt-6 max-w-xl">{c.lead}</p>
    <a href={TOKIMOCHI_APP_STORE_URL} class="mt-8 inline-block rounded bg-slate-900 px-6 py-3 text-white">{c.cta}</a>
  </section>
  <section class="py-8">
    <h2 class="text-2xl font-bold">{c.problemTitle}</h2>
    <p class="mt-3 leading-8">{c.problem}</p>
  </section>
  <section class="py-8">
    <h2 class="text-2xl font-bold">{c.solutionTitle}</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      {c.solution.map((s) => <li class="rounded border border-slate-200 p-4">{s}</li>)}
    </ul>
  </section>
  <p class="py-8"><a href={localePath(lang, '/articles/goal/')} class="text-blue-700 underline">{c.more}</a></p>
</BaseLayout>
