---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHero from '../../components/AppHero.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import { TOKIMOCHI_APP_STORE_URL } from '../../consts';
import { langFromPath, langStaticPaths, localePath } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

// Placeholder copy: replace with the real LP text.
const copy = {
  ja: {
    name: '時もち',
    title: '時もち',
    description: '時もちは、スマホとの付き合い方を見直すためのアプリです。',
    tagline: 'Be Time Rich',
    lead: '【ここにアプリの説明文】',
    cta: 'App Storeでダウンロード',
    more: '私たちが実現したいこと',
    screenshot: 'スクリーンショット',
    problemEyebrow: 'Problem',
    problemTitle: 'スマホに、時間を奪われていませんか?',
    stat: '【00】%',
    statLabel: '【ここに課題を表す数値の説明】',
    featuresEyebrow: 'Features',
    featuresTitle: '時もちができること',
    features: [
      { icon: 'clock', title: '【特徴1のタイトル】', body: '【特徴1の説明文】' },
      { icon: 'bell-off', title: '【特徴2のタイトル】', body: '【特徴2の説明文】' },
      { icon: 'leaf', title: '【特徴3のタイトル】', body: '【特徴3の説明文】' },
    ],
  },
  en: {
    name: 'Time Rich',
    title: 'Time Rich',
    description: 'Time Rich helps you rethink your relationship with your smartphone.',
    tagline: 'Be Time Rich',
    lead: '[App description goes here]',
    cta: 'Download on the App Store',
    more: 'What we want to achieve',
    screenshot: 'App screenshot',
    problemEyebrow: 'Problem',
    problemTitle: 'Is your phone taking your time?',
    stat: '[00]%',
    statLabel: '[A statistic describing the problem goes here]',
    featuresEyebrow: 'Features',
    featuresTitle: 'What Time Rich does',
    features: [
      { icon: 'clock', title: '[Feature 1 title]', body: '[Feature 1 description]' },
      { icon: 'bell-off', title: '[Feature 2 title]', body: '[Feature 2 description]' },
      { icon: 'leaf', title: '[Feature 3 title]', body: '[Feature 3 description]' },
    ],
  },
} as const;
const lang = langFromPath(Astro.url.pathname);
const c = copy[lang];
---

<BaseLayout title={c.title} description={c.description} wide>
  <AppHero
    name={c.name}
    tagline={c.tagline}
    lead={c.lead}
    primary={{ href: TOKIMOCHI_APP_STORE_URL, label: c.cta }}
    secondary={{ href: localePath(lang, '/articles/goal/'), label: c.more }}
    screenshotLabel={c.screenshot}
  />

  <section class="my-10 overflow-hidden rounded-[2.5rem] bg-ink px-6 py-14 text-center text-white sm:px-12">
    <p class="eyebrow !text-(--accent)">{c.problemEyebrow}</p>
    <h2 class="mx-auto mt-3 max-w-2xl text-2xl font-bold sm:text-4xl">{c.problemTitle}</h2>
    <p class="mt-8 font-display text-7xl font-bold text-(--accent) sm:text-8xl">{c.stat}</p>
    <p class="mx-auto mt-3 max-w-md text-white/70">{c.statLabel}</p>
  </section>

  <FeatureCards eyebrow={c.featuresEyebrow} title={c.featuresTitle} items={c.features.map((f) => ({ ...f }))} />
</BaseLayout>
