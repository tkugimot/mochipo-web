---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHero from '../../components/AppHero.astro';
import FeatureShowcase from '../../components/FeatureShowcase.astro';
import screenshotJa from '../../assets/screenshot_ja.png';
import screenshotEn from '../../assets/screenshot_en.png';
import timelimitJa from '../../assets/timelimit_ja.png';
import timelimitEn from '../../assets/timelimit_en.png';
import scheduleJa from '../../assets/schedule_ja.png';
import scheduleEn from '../../assets/schedule_en.png';
import { TOKIMOCHI_APP_STORE_URL } from '../../consts';
import { langFromPath, langStaticPaths, localePath } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

// Placeholder copy: replace with the real LP text.
const copy = {
  ja: {
    name: '時もち',
    title: '時もち',
    description: '時もちは、スマホとの付き合い方を見直すためのアプリです。',
    tagline: 'Be Time Rich',
    lead: '【ここにアプリの説明文】',
    cta: 'App Storeでダウンロード',
    more: '私たちが実現したいこと',
    shots: ['タイムリミット画面', 'クイックブロック画面', 'スケジュール画面'],
    problemEyebrow: 'Problem',
    problemTitle: 'スマホに、時間を奪われていませんか?',
    stat: '【00】%',
    statLabel: '【ここに課題を表す数値の説明】',
    featuresEyebrow: 'Features',
    featuresTitle: '時もちができること',
    // Draft copy taken from the app UI. Replace with final wording.
    features: [
      { icon: 'lock', title: 'クイックブロック', body: '時間を選ぶだけで、今すぐアプリをブロックできます。' },
      { icon: 'clock', title: 'タイムリミット', body: '1日の利用時間に上限を設定。終了の15分前にプッシュ通知でお知らせします。' },
      { icon: 'calendar', title: 'スケジュール', body: '毎日や曜日ごとに、ブロックする時間帯を決められます。' },
    ],
  },
  en: {
    name: 'Time Rich',
    title: 'Time Rich',
    description: 'Time Rich helps you rethink your relationship with your smartphone.',
    tagline: 'Be Time Rich',
    lead: '[App description goes here]',
    cta: 'Download on the App Store',
    more: 'What we want to achieve',
    shots: ['Time Limit screen', 'Quick Block screen', 'Schedule screen'],
    problemEyebrow: 'Problem',
    problemTitle: 'Is your phone taking your time?',
    stat: '[00]%',
    statLabel: '[A statistic describing the problem goes here]',
    featuresEyebrow: 'Features',
    featuresTitle: 'What Time Rich does',
    // Draft copy taken from the app UI. Replace with final wording.
    features: [
      { icon: 'lock', title: 'Quick Block', body: 'Pick a duration and block your apps right away.' },
      { icon: 'clock', title: 'Time Limit', body: 'Set a daily limit. You get a push notification 15 minutes before it ends.' },
      { icon: 'calendar', title: 'Schedule', body: 'Choose the hours to block, every day or on specific weekdays.' },
    ],
  },
} as const;
const lang = langFromPath(Astro.url.pathname);
const c = copy[lang];
const images = lang === 'ja' ? [timelimitJa, screenshotJa, scheduleJa] : [timelimitEn, screenshotEn, scheduleEn];
const screenshots = images.map((src, i) => ({ src, alt: c.shots[i] }));
// Feature order is Quick, Time Limit, Schedule; the hero fan is [Time Limit, Quick, Schedule].
const featureImages = [images[1], images[0], images[2]];
const features = c.features.map((f, i) => ({ ...f, image: featureImages[i], alt: [c.shots[1], c.shots[0], c.shots[2]][i] }));
---

<BaseLayout title={c.title} description={c.description} wide>
  <AppHero
    name={c.name}
    tagline={c.tagline}
    lead={c.lead}
    primary={{ href: TOKIMOCHI_APP_STORE_URL, label: c.cta }}
    secondary={{ href: localePath(lang, '/articles/goal/'), label: c.more }}
    screenshots={[screenshots[1]]}
  />

  <section class="my-10 overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-[#1a1fd6] via-[#4a2bb8] to-[#7b2fb0] px-6 py-14 text-center text-white sm:px-12">
    <p class="eyebrow !text-[#8ff0e0]">{c.problemEyebrow}</p>
    <h2 class="mx-auto mt-3 max-w-2xl text-2xl font-bold sm:text-4xl">{c.problemTitle}</h2>
    <p class="mt-8 font-display text-7xl font-bold text-[#8ff0e0] sm:text-8xl">{c.stat}</p>
    <p class="mx-auto mt-3 max-w-md text-white/80">{c.statLabel}</p>
  </section>

  <FeatureShowcase eyebrow={c.featuresEyebrow} title={c.featuresTitle} items={features} />
</BaseLayout>
