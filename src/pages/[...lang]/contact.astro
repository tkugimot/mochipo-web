---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { langFromPath, langStaticPaths, t } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const ui = t(langFromPath(Astro.url.pathname)).contact;
---

<BaseLayout title={ui.title} description={ui.description}>
  <header class="py-4 text-center">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-2 text-4xl font-bold">{ui.title}</h1>
    <p class="mt-3 text-ink-soft">{ui.description}</p>
  </header>
  <div class="card mt-6"><ContactForm /></div>
</BaseLayout>
