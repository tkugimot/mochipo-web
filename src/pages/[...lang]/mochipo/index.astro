---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppHero from '../../../components/AppHero.astro';
import FeatureCards from '../../../components/FeatureCards.astro';
import { langFromPath, langStaticPaths, localePath } from '../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

// Placeholder copy: replace with the real LP text.
const copy = {
  ja: {
    name: 'もち歩',
    description: 'もち歩の紹介ページです。',
    tagline: '【キャッチコピー】',
    lead: '【ここにアプリの説明文】',
    screenshot: 'スクリーンショット',
    featuresEyebrow: 'Features',
    featuresTitle: 'もち歩の特徴',
    features: [
      { icon: 'walk', title: '【特徴1のタイトル】', body: '【特徴1の説明文】' },
      { icon: 'pin', title: '【特徴2のタイトル】', body: '【特徴2の説明文】' },
      { icon: 'sparkle', title: '【特徴3のタイトル】', body: '【特徴3の説明文】' },
    ],
    terms: '利用規約',
    privacy: 'プライバシーポリシー',
  },
  en: {
    name: 'mochipo',
    description: 'Introducing mochipo.',
    tagline: '[Tagline]',
    lead: '[App description goes here]',
    screenshot: 'App screenshot',
    featuresEyebrow: 'Features',
    featuresTitle: 'Features',
    features: [
      { icon: 'walk', title: '[Feature 1 title]', body: '[Feature 1 description]' },
      { icon: 'pin', title: '[Feature 2 title]', body: '[Feature 2 description]' },
      { icon: 'sparkle', title: '[Feature 3 title]', body: '[Feature 3 description]' },
    ],
    terms: 'Terms of Service',
    privacy: 'Privacy Policy',
  },
} as const;
const lang = langFromPath(Astro.url.pathname);
const c = copy[lang];
---

<BaseLayout title={c.name} description={c.description} theme="mochipo" wide>
  <AppHero name={c.name} tagline={c.tagline} lead={c.lead} screenshotLabel={c.screenshot} />
  <FeatureCards eyebrow={c.featuresEyebrow} title={c.featuresTitle} items={c.features.map((f) => ({ ...f }))} />
  <p class="flex justify-center gap-8 py-6 text-sm">
    <a href={localePath(lang, '/mochipo/terms/')} class="link">{c.terms}</a>
    <a href={localePath(lang, '/mochipo/privacy/')} class="link">{c.privacy}</a>
  </p>
</BaseLayout>
