---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegalBody from '../../../components/LegalBody.astro';
import { getLegal } from '../../../lib/content';
import { langFromPath, langStaticPaths } from '../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const entry = await getLegal(langFromPath(Astro.url.pathname), 'mochipo-privacy');
---

<BaseLayout title={entry.data.title} description={entry.data.description} noindex={entry.data.draft} theme="mochipo">
  <LegalBody entry={entry} />
</BaseLayout>
