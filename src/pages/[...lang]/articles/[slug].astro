---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArticles, hasArticle, slugOf } from '../../../lib/content';
import { LANGS, formatDate, langFromPath, localePath, t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const article of await getArticles(lang)) {
      paths.push({
        params: { lang: lang === 'ja' ? undefined : lang, slug: slugOf(article.id) },
        props: { article },
      });
    }
  }
  return paths;
}

const { article } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const slug = slugOf(article.id);
const otherLang = lang === 'ja' ? 'en' : 'ja';
const noTranslation = !(await hasArticle(otherLang, slug));
const { Content } = await render(article);
const { title, description, pubDate, app, tags, ogImage } = article.data;
---

<BaseLayout title={title} description={description} image={ogImage} type="article" publishedTime={pubDate} noTranslation={noTranslation} theme={app === 'mochipo' ? 'mochipo' : 'tokimochi'}>
  <article>
    <header class="rounded-[2rem] bg-(--accent-soft) px-6 py-10 sm:px-10">
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="rounded-full bg-white/80 px-3 py-1 font-bold text-(--accent-strong)">{t(lang).apps[app]}</span>
        <time datetime={pubDate.toISOString()} class="text-ink-soft">{formatDate(pubDate, lang)}</time>
        {tags.map((tag) => <span class="text-ink-soft">#{tag}</span>)}
      </div>
      <h1 class="mt-4 text-3xl leading-snug font-bold sm:text-4xl">{title}</h1>
    </header>
    <div class="prose mt-10 px-1"><Content /></div>
  </article>
  <p class="mt-12"><a href={localePath(lang, '/articles/')} class="btn-ghost">&larr; {t(lang).articles.back}</a></p>
</BaseLayout>
