---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getArticles } from '../../../lib/content';
import { langFromPath, langStaticPaths, t } from '../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = langFromPath(Astro.url.pathname);
const ui = t(lang).articles;
const articles = await getArticles(lang);
---

<BaseLayout title={ui.title} description={ui.description} wide>
  <header class="py-6 text-center">
    <p class="eyebrow">Articles</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{ui.title}</h1>
    <p class="mt-3 text-ink-soft">{ui.description}</p>
  </header>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map((a) => <ArticleCard article={a} />)}
  </div>
  {articles.length === 0 && <p class="text-center text-ink-soft">{ui.none}</p>}
</BaseLayout>
