---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES, CATEGORY_LABELS } from '../../consts';

const posts = await getPosts();
const counts = CATEGORIES.map((c) => ({ id: c, count: posts.filter((p) => p.data.category === c).length }));
---

<BaseLayout title="カテゴリー" description="カテゴリー別の記事一覧です。">
  <h1 class="text-3xl font-bold">カテゴリー</h1>
  <ul class="mt-6 space-y-2">
    {counts.map((c) => (
      <li><a href={`/categories/${c.id}`} class="text-blue-700 underline">{CATEGORY_LABELS[c.id]}</a> ({c.count})</li>
    ))}
  </ul>
</BaseLayout>
