---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES, CATEGORY_LABELS } from '../../consts';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: (typeof CATEGORIES)[number] };
const posts = (await getPosts()).filter((p) => p.data.category === category);
const label = CATEGORY_LABELS[category];
---

<BaseLayout title={`${label}の記事`} description={`カテゴリー「${label}」の記事一覧です。`}>
  <h1 class="text-3xl font-bold">{label}</h1>
  <div class="mt-6 divide-y divide-slate-200">
    {posts.length ? posts.map((post) => <PostCard post={post} />) : <p class="text-slate-500">記事はまだありません。</p>}
  </div>
</BaseLayout>
