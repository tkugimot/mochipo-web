---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';

// The 404 page is served for every missing URL, so it shows both languages.
const ja = t('ja').notFound;
const en = t('en').notFound;
---

<BaseLayout title={`${ja.title} / ${en.title}`} description={ja.text} noindex noTranslation>
  <h1 class="text-3xl font-bold">404</h1>
  <p class="mt-3">{ja.text} <a href="/" class="text-blue-700 underline">{ja.home}</a></p>
  <p class="mt-2">{en.text} <a href="/en/" class="text-blue-700 underline">{en.home}</a></p>
</BaseLayout>
