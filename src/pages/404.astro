---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';

// The 404 page is served for every missing URL, so it shows both languages.
const ja = t('ja').notFound;
const en = t('en').notFound;
---

<BaseLayout title={`${ja.title} / ${en.title}`} description={ja.text} noindex noTranslation>
  <div class="py-16 text-center">
    <p class="font-display text-8xl font-bold text-(--accent)">404</p>
    <p class="mt-6">{ja.text}</p>
    <p class="mt-1 text-ink-soft">{en.text}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">{ja.home}</a>
      <a href="/en/" class="btn-ghost">{en.home}</a>
    </div>
  </div>
</BaseLayout>
