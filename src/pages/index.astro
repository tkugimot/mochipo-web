---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <h1 class="text-3xl font-bold">{SITE_TITLE}</h1>
  <p class="mt-3 text-slate-600">{SITE_DESCRIPTION}</p>
  <h2 class="mt-10 text-lg font-semibold">最新の記事</h2>
  <div class="divide-y divide-slate-200">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
  <p class="mt-4"><a href="/blog" class="text-blue-700 underline">記事一覧へ</a></p>
</BaseLayout>
