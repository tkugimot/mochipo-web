---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langFromPath } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  noTranslation?: boolean;
  /** Full-width content (landing pages). Default is a readable column. */
  wide?: boolean;
}
const { wide = false, ...seo } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-800">
    <Header noTranslation={seo.noTranslation} />
    <main class:list={['mx-auto w-full flex-1 px-4 py-8 sm:py-12', wide ? 'max-w-5xl' : 'max-w-3xl']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
