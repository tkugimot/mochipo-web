---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS } from '../consts';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
---

<article class="py-5">
  <div class="flex items-center gap-3 text-sm text-slate-500">
    <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' })}</time>
    <a href={`/categories/${category}`} class="rounded bg-slate-100 px-2 py-0.5 hover:bg-slate-200">{CATEGORY_LABELS[category]}</a>
  </div>
  <h2 class="mt-1 text-xl font-bold"><a href={`/blog/${post.id}`} class="hover:underline">{title}</a></h2>
  <p class="mt-1 text-slate-600">{description}</p>
</article>
