---
import { OPERATOR } from '../consts';
import { langFromPath, localePath, t } from '../i18n/ui';
import MochiMark from './MochiMark.astro';

const lang = langFromPath(Astro.url.pathname);
const ui = t(lang);
const groups = [
  {
    title: ui.apps.tokimochi,
    links: [
      { href: localePath(lang, '/'), label: ui.apps.tokimochi },
      { href: localePath(lang, '/articles/policy/'), label: ui.footer.policy },
    ],
  },
  {
    title: ui.apps.mochipo,
    links: [
      { href: localePath(lang, '/mochipo/'), label: ui.apps.mochipo },
      { href: localePath(lang, '/mochipo/terms/'), label: ui.footer.terms },
      { href: localePath(lang, '/mochipo/privacy/'), label: ui.footer.privacy },
    ],
  },
  {
    title: ui.nav.about,
    links: [
      { href: localePath(lang, '/articles/'), label: ui.nav.articles },
      { href: localePath(lang, '/aboutus/'), label: ui.nav.about },
      { href: localePath(lang, '/contact/'), label: ui.nav.contact },
    ],
  },
];
---

<footer class="mt-10 border-t border-black/5 bg-white/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.3fr_repeat(3,1fr)]">
    <div>
      <a href={localePath(lang, '/')} class="flex items-center gap-2 font-display text-xl font-bold">
        <MochiMark class="size-9 text-ink" />
        {ui.siteTitle}
      </a>
      <p class="mt-3 max-w-xs text-sm leading-6 text-ink-soft">{ui.siteDescription}</p>
    </div>
    {groups.map((g) => (
      <nav aria-label={g.title}>
        <p class="font-display font-bold">{g.title}</p>
        <ul class="mt-3 space-y-2 text-sm text-ink-soft">
          {g.links.map((l) => <li><a href={l.href} class="hover:text-ink hover:underline">{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <p class="border-t border-black/5 py-5 text-center text-xs text-ink-soft">&copy; {new Date().getFullYear()} {OPERATOR}</p>
</footer>
