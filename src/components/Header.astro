---
import { langFromPath, localePath, stripLang, t } from '../i18n/ui';
import MochiMark from './MochiMark.astro';

interface Props { noTranslation?: boolean }
const { noTranslation = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const other = lang === 'ja' ? 'en' : 'ja';
const ui = t(lang);
// Without a translation of this page, the language switch lands on the article list.
const switchHref = localePath(other, noTranslation ? '/articles/' : stripLang(Astro.url.pathname));

const links = [
  { href: localePath(lang, '/'), label: ui.apps.tokimochi },
  { href: localePath(lang, '/mochipo/'), label: ui.apps.mochipo },
  { href: localePath(lang, '/articles/'), label: ui.nav.articles },
  { href: localePath(lang, '/aboutus/'), label: ui.nav.about },
];
const contact = { href: localePath(lang, '/contact/'), label: ui.nav.contact };
const linkClass = 'rounded-full px-4 py-2 text-sm font-medium transition hover:bg-black/5';
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-cream/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={localePath(lang, '/')} class="flex items-center gap-2 font-display text-xl font-bold">
      <MochiMark class="size-9 text-ink" />
      {ui.siteTitle}
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {links.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
      <a href={contact.href} class="btn-primary ml-2 !px-5 !py-2 text-sm">{contact.label}</a>
      <a href={switchHref} hreflang={other} lang={other} class="ml-1 rounded-full border border-ink/15 px-3 py-1.5 text-sm hover:bg-white">{ui.nav.language}</a>
    </nav>

    <details class="group relative md:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-ink/15 bg-white/70" aria-label="Menu">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <nav aria-label="Main (mobile)" class="absolute right-0 mt-3 flex w-64 flex-col gap-1 rounded-3xl border border-black/5 bg-white p-3 shadow-lift">
        {[...links, contact].map((l) => <a href={l.href} class="rounded-2xl px-4 py-3 font-medium hover:bg-cream">{l.label}</a>)}
        <a href={switchHref} hreflang={other} lang={other} class="rounded-2xl px-4 py-3 text-ink-soft hover:bg-cream">{ui.nav.language}</a>
      </nav>
    </details>
  </div>
</header>
