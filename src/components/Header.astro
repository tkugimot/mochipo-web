---
import { SITE_TITLE } from '../consts';

const links = [
  { href: '/blog', label: 'ブログ' },
  { href: '/categories', label: 'カテゴリー' },
  { href: '/contact', label: 'お問い合わせ' },
];
---

<header class="border-b border-slate-200">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
    <a href="/" class="text-lg font-bold">{SITE_TITLE}</a>
    <nav aria-label="メイン">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
        {links.map((l) => <li><a href={l.href} class="py-2 hover:underline">{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
