---
import { langFromPath, localePath, stripLang, t } from '../i18n/ui';

interface Props { noTranslation?: boolean }
const { noTranslation = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const other = lang === 'ja' ? 'en' : 'ja';
const ui = t(lang);
// Without a translation of this page, the language switch lands on the article list.
const switchHref = localePath(other, noTranslation ? '/articles/' : stripLang(Astro.url.pathname));

const links = [
  { href: localePath(lang, '/'), label: ui.apps.tokimochi },
  { href: localePath(lang, '/mochipo/'), label: ui.apps.mochipo },
  { href: localePath(lang, '/articles/'), label: ui.nav.articles },
  { href: localePath(lang, '/aboutus/'), label: ui.nav.about },
  { href: localePath(lang, '/contact/'), label: ui.nav.contact },
];
---

<header class="border-b border-slate-200">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
    <a href={localePath(lang, '/')} class="text-lg font-bold">{ui.siteTitle}</a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {links.map((l) => <li><a href={l.href} class="inline-block py-2 hover:underline">{l.label}</a></li>)}
        <li><a href={switchHref} hreflang={other} lang={other} class="inline-block rounded border border-slate-300 px-2 py-1 hover:bg-slate-50">{ui.nav.language}</a></li>
      </ul>
    </nav>
  </div>
</header>
