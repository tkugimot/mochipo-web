---
import { DEFAULT_OG_IMAGE } from '../consts';
import { LANGS, langFromPath, localePath, stripLang, t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  /** True when the other-language version of this page does not exist. */
  noTranslation?: boolean;
}
const { title, description, image = DEFAULT_OG_IMAGE, type = 'website', publishedTime, noindex = false, noTranslation = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const siteTitle = t(lang).siteTitle;
const base = stripLang(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const alternates = noTranslation ? [] : LANGS.map((l) => ({ lang: l, href: new URL(localePath(l, base), Astro.site) }));
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
