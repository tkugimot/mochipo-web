---
import { TOPICS } from '../lib/contactSchema';
import { langFromPath, t } from '../i18n/ui';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const lang = langFromPath(Astro.url.pathname);
const ui = t(lang).contact;
const messages = JSON.stringify({ sending: ui.sending, success: ui.success, failure: ui.failure, errors: ui.errors });
const input = 'mt-1 w-full rounded border border-slate-300 px-3 py-2';
---

<form id="contact-form" class="space-y-5" novalidate data-messages={messages}>
  <div>
    <label for="name" class="block text-sm font-medium">{ui.name}</label>
    <input id="name" name="name" required maxlength="100" autocomplete="name" class={input} />
  </div>
  <div>
    <label for="email" class="block text-sm font-medium">{ui.email}</label>
    <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" class={input} />
  </div>
  <div>
    <label for="topic" class="block text-sm font-medium">{ui.topic}</label>
    <select id="topic" name="topic" class={input}>
      {TOPICS.map((v) => <option value={v}>{ui.topics[v]}</option>)}
    </select>
  </div>
  <div>
    <label for="message" class="block text-sm font-medium">{ui.message}</label>
    <textarea id="message" name="message" required minlength="10" maxlength="5000" rows="7" class={input}></textarea>
  </div>
  <!-- Honeypot -->
  <div class="hidden" aria-hidden="true">
    <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="cf-turnstile" data-sitekey={siteKey} data-language={lang}></div>
  <button type="submit" class="w-full rounded bg-slate-900 px-5 py-3 text-white disabled:opacity-50 sm:w-auto">{ui.submit}</button>
  <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
  <noscript><p class="text-sm text-red-700">{ui.noscript}</p></noscript>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  import { contactSchema } from '../lib/contactSchema';

  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const status = document.querySelector<HTMLElement>('#form-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const messages = JSON.parse(form.dataset.messages!) as {
    sending: string; success: string; failure: string; errors: Record<string, string>;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const parsed = contactSchema.safeParse({
      name: data.get('name'),
      email: data.get('email'),
      message: data.get('message'),
      topic: data.get('topic'),
      website: data.get('website') ?? '',
      turnstileToken: data.get('cf-turnstile-response') ?? '',
    });
    if (!parsed.success) {
      status.className = 'text-sm text-red-700';
      status.textContent = messages.errors[parsed.error.issues[0].message] ?? messages.failure;
      return;
    }
    button.disabled = true;
    status.className = 'text-sm';
    status.textContent = messages.sending;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(parsed.data),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.className = 'text-sm text-green-700';
      status.textContent = messages.success;
    } catch {
      status.className = 'text-sm text-red-700';
      status.textContent = messages.failure;
    } finally {
      button.disabled = false;
      // Tokens are single-use; get a fresh one for any retry.
      (window as any).turnstile?.reset();
    }
  });
</script>
