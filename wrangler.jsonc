{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mochipo-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Non-secret settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY) are set
  // with `wrangler secret put` or in the dashboard. Replace these before deploying.
  "vars": {
    "CONTACT_TO": "you@example.com",
    "CONTACT_FROM": "mochipo <no-reply@mochipo.example.com>",
    "ALLOWED_ORIGIN": "https://mochipo.example.com"
  }
}
