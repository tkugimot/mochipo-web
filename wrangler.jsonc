{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mochipo-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Non-secret settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY) are set
  // with `wrangler secret put` or in the dashboard. ALLOWED_ORIGIN is a comma-separated list.
  "vars": {
    "CONTACT_TO": "tokimochi.dev@gmail.com",
    "CONTACT_FROM": "mochipo <no-reply@toki-mochi.com>",
    "ALLOWED_ORIGIN": "https://toki-mochi.com,https://mochipo-web.toshimitsu-kugimoto.workers.dev"
  }
}
